    {
      "id": "SEC-019",
      "kind": "secret",
      "category": "prose",
      "expected": "known_gap",
      "text": "the database password is corpus-prose-11 for now",
      "secret": "corpus-prose-11",
      "note": "no format: the hardest case (hypothesis H4)"
    },
    {
      "id": "SEC-020",
      "kind": "secret",
      "category": "prose",
      "expected": "known_gap",
      "text": "the secret key is wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
      "secret": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
      "note": "no format: the hardest case (hypothesis H4)"
    },
    {
      "id": "SEC-021",
      "kind": "secret",
      "category": "key-value",
      "expected": "known_gap",
      "text": "data:\n  db-conn: Y29ycHVzLWI2NC0xMw==",
      "secret": "Y29ycHVzLWI2NC0xMw==",
