{
  "version": "1.1.0",
  "description": "Synthetic secrets corpus for experiment E4 (docs/investigacion/metodologia.md). Every value is fake. 'secret' items must not survive redaction unless marked known_gap; 'benign' items must stay unchanged unless marked known_false_positive.",
  "items": [
    {
      "id": "SEC-001",
      "kind": "secret",
      "category": "aws-access-key-id",
      "expected": "redacted",
      "text": "key AKIAIOSFODNN7EXAMPLE leaked in the build log",
      "secret": "AKIAIOSFODNN7EXAMPLE"
    },
    {
      "id": "SEC-002",
      "kind": "secret",
      "category": "aws-secret-access-key",
      "expected": "redacted",
