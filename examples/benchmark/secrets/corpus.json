    },
    {
      "id": "BEN-003",
      "kind": "benign",
      "category": "terraform",
      "expected": "unchanged",
      "text": "resource \"aws_secretsmanager_secret\" \"db\" {"
    },
    {
      "id": "BEN-004",
      "kind": "benign",
      "category": "logs",
      "expected": "unchanged",
      "text": "token bucket rate limit reached for registry.example.com"
    },
    {
      "id": "BEN-005",
      "kind": "benign",
      "category": "terraform",
      "expected": "unchanged",
      "text": "kms_key_id = aws_kms_key.logs.arn"
    },
    {
      "id": "BEN-006",
      "kind": "benign",
      "category": "terraform",
      "expected": "known_false_positive",
      "text": "secret_string = jsonencode(var.db)",
      "note": "a reference expression, not a value, is masked: conservative but loses context"
    },
    {
      "id": "BEN-007",
      "kind": "benign",
      "category": "logs",
      "expected": "unchanged",
      "text": "Back-off pulling image example.com/app:1.2.3"
    },
    {
      "id": "BEN-008",
      "kind": "benign",
      "category": "logs",
      "expected": "unchanged",
      "text": "memory limit 128Mi exceeded (OOMKilled)"
    },
    {
      "id": "BEN-009",
      "kind": "benign",
      "category": "git",
      "expected": "unchanged",
      "text": "commit 3f2a1b4c5d6e7f8091a2b3c4d5e6f708192a3b4c"
    },
    {
      "id": "BEN-010",
      "kind": "benign",
      "category": "logs",
      "expected": "unchanged",
      "text": "timestamp 1700000000000 ms"
    },
    {
      "id": "SEC-022",
      "kind": "secret",
      "category": "json-key-value",
      "expected": "redacted",
      "text": "{\"detail\": \"{\\\"api_key\\\": \\\"corpus-escaped-16\\\"}\"}",
      "secret": "corpus-escaped-16",
